# ------------------------------------------------------------------
# Glide (API de tablas / Business-Enterprise plan)
# ------------------------------------------------------------------
# Token de la API de Glide (Settings > Developer > API en la app de Glide)
GLIDE_API_TOKEN=
# ID de la app de Glide donde vive CoreTrack
GLIDE_APP_ID=

# Nombres EXACTOS de las tablas tal como aparecen habilitadas para la API
# de Glide (Data Editor > tabla > "..." > Enable Public API). Deben
# coincidir con lo que confirmemos con el usuario.
GLIDE_TABLE_OC="Comtrol de Ordenes de Compra Track"
GLIDE_TABLE_HARDWARE="*HARDWARE"
GLIDE_TABLE_SOFTWARE="*SOFTWARE"
GLIDE_TABLE_USERS="Users"

# ------------------------------------------------------------------
# Vercel Blob (almacenamiento propio del proyecto, NO Glide): guarda el
# log de notificaciones y las plantillas de correo como JSON. Se completa
# sola al conectar un Blob Store al proyecto en Vercel (Storage tab).
# ------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=

# ------------------------------------------------------------------
# Gmail API (OAuth2 - cuenta que enviará las notificaciones)
# ------------------------------------------------------------------
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=https://developers.google.com/oauthplayground
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=coretrack@coresolutions.com.ec

# ------------------------------------------------------------------
# Destinatarios adicionales fijos por tipo de evento (opcional).
# Lista separada por comas. Se suman a los correos que vengan desde
# las columnas de la fila de Glide (ej. Correo 0/1/2 de la OC).
# ------------------------------------------------------------------
NOTIFY_EXTRA_NUEVA_OC=
NOTIFY_EXTRA_HW_AGREGADO=
NOTIFY_EXTRA_SW_AGREGADO=
NOTIFY_EXTRA_OPI_PROGRESO=

# ------------------------------------------------------------------
# Seguridad del endpoint (Vercel Cron ya envía este header
# automáticamente si se define CRON_SECRET en el proyecto)
# ------------------------------------------------------------------
CRON_SECRET=

# ------------------------------------------------------------------
# Panel /admin para editar los textos de los correos (asunto/cuerpo) sin
# tocar código. Usuario/contraseña de HTTP Basic Auth.
# ------------------------------------------------------------------
ADMIN_USER=
ADMIN_PASSWORD=
